# ASP.NET Web Forms (.NET Framework 4.8.1) + LaTeX + Visual Studio .gitignore

###############################################################################
# Build outputs - compiled binaries and intermediate files
###############################################################################
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*/bin/
*/obj/
Demo_ASPX/bin/
Demo_ASPX/obj/
Publish/
PublishProfiles/
*/Publish/
*.Publish.xml
*.aps
*.bak
*.tmp
*.temp

###############################################################################
# NuGet - packages folder except repositories.config
###############################################################################
packages/*
!packages/repositories.config
!packages/*.config
*.nupkg
*.snupkg
*.nuspec.bak
project.lock.json
project.fragment.lock.json
artifacts/

###############################################################################
# Visual Studio - user, workspace and test files
###############################################################################
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.sln.ide/
*.csproj.user
*.vbproj.user
*.aspx.user
TestResults/
*.trx
*.coverage
*.coveragexml
Coverage/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb

###############################################################################
# LaTeX intermediate files (BaoCao_LaTeX, Slide_LaTeX)
###############################################################################
*.aux
*.bbl
*.blg
*.brf
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
_minted*
*.xdv

###############################################################################
# Operating system - Windows and macOS junk files
###############################################################################
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*~
.directory

###############################################################################
# App_Data - local databases and uploaded attachments
###############################################################################
App_Data/*.mdf
App_Data/*.ldf
App_Data/*.ndf
App_Data/*.bak
App_Data/*.trn
App_Data/*.log
*.mdf
*.ldf
App_Data/Uploads/*
!App_Data/Uploads/.gitkeep
App_Data/Temp/*
!App_Data/Temp/.gitkeep
App_Data/ELMAH/*
!App_Data/ELMAH/.gitkeep

###############################################################################
# Logs and temporary runtime files
###############################################################################
*.tlog
logs/
temp/
tmp/
